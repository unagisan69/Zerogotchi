@lru_cache(maxsize=18)
def theme_face(theme, mood):
    path = Path(__file__).resolve().parent / "themes" / theme / f"{mood}.png"
    with Image.open(path) as source:
        icon = source.convert("RGB").resize((90, 90), Image.Resampling.LANCZOS)
    mask = Image.new("L", icon.size)
    ImageDraw.Draw(mask).rounded_rectangle((0, 0, 89, 89), radius=8, fill=255)
    return icon, mask


class Display:
    def __init__(self, device):
        self.fd = device.fileno()
        mode = bytearray(160)
        fixed = bytearray(80)
        fcntl.ioctl(self.fd, 0x4600, mode)
        fcntl.ioctl(self.fd, 0x4602, fixed)
        width, height, _, _, xoffset, yoffset, bpp = struct.unpack_from("=7I", mode)
        red, green, blue = (struct.unpack_from("=2I", mode, offset) for offset in (32, 44, 56))
        stride = struct.unpack_from("=I", fixed, 48)[0]
        if (width, height, bpp, red, green, blue) != (320, 170, 16, (11, 5), (5, 6), (0, 5)):
            raise OSError("Expected Cardputer Zero RGB565 LCD")
        if stride < (xoffset + WIDTH) * 2:
            raise OSError("Invalid LCD line length")
        self.stride = stride
        self.offset = yoffset * stride + xoffset * 2
        self.title = ImageFont.truetype(f"{FONT_DIR}/DejaVuSans-Bold.ttf", 18)
        self.body = ImageFont.truetype(f"{FONT_DIR}/DejaVuSans.ttf", 13)
        self.small = ImageFont.truetype(f"{FONT_DIR}/DejaVuSans.ttf", 11)

    def wrap(self, text, draw):
        for paragraph in text.splitlines():
            if not paragraph:
                yield ""
                continue
            line = ""
            for word in paragraph.split():
                candidate = (line + " " + word).strip()
                if line and draw.textlength(candidate, font=self.body) > 292:
                    yield line
                    line = word
                else:
                    line = candidate
            if line:
                yield line

    def draw(self, title, message, items, index, footer):
        image = Image.new("RGB", (WIDTH, HEIGHT), BG)
        draw = ImageDraw.Draw(image)
        draw.text((12, 8), title, font=self.title, fill=TEAL)
        draw.line((12, 33, 308, 33), fill=PANEL)
        y = 40
        for line in self.wrap(message, draw):
            draw.text((13, y), line, font=self.body, fill=WHITE)
            y += 16
        window = max(1, (147 - y) // 21)
        first = min(max(0, index - window + 1), max(0, len(items) - window))
        for i in range(first, min(len(items), first + window)):
            label = items[i][0]
            if i == index:
                draw.rounded_rectangle((9, y, 310, y + 19), radius=4, fill=PANEL)
            if draw.textlength(label, font=self.body) > 281:
                while draw.textlength(label + "…", font=self.body) > 281:
                    label = label[:-1]
                label += "…"
            draw.text((15, y + 1), label, font=self.body, fill=TEAL if i == index else WHITE)
            y += 21
        draw.text((12, 151), footer, font=self.small, fill=MUTED)
        self.paint(image)

    def draw_computer(self, draw, phase, blink):
        face = TEAL
        resting = phase in ("Idling", "Paused")
        mood = {"Idling": "sleep", "Paused": "sleep", "Deauthing": "focus", "Checking": "squint",
                "Saving": "happy", "Uploading": "focus"}.get(phase, "alert")
        tilt = -3 if blink and not resting else 0
        draw.line((59, 44, 67, 33 + tilt, 75, 33 + tilt), fill=face, width=3)
        draw.ellipse((73, 29 + tilt, 81, 37 + tilt), fill=face)
        draw.rounded_rectangle((25, 44, 94, 92), radius=9, outline=face, width=3)
        for x in (40, 72):
            if mood == "squint" and not blink:
                draw.line((x, 61, x + 6, 64, x, 67), fill=face, width=2)
            elif mood == "sleep" or blink:
                draw.line((x, 64, x + 7, 64), fill=face, width=2)
            elif mood == "focus":
                draw.line((x, 59, x + 7, 64), fill=face, width=3)
            elif mood == "happy":
                draw.arc((x, 57, x + 8, 69), 190, 350, fill=face, width=2)
            else:
                draw.rectangle((x, 60, x + 6, 68), fill=face)
        if mood in ("focus", "squint"):
            draw.line((54, 77, 65, 77), fill=face, width=2)
        else:
            draw.line((50, 75, 55, 79, 63, 79, 68, 75), fill=face, width=2)

    def draw_auto(self, status, blink, gps_on, online, battery, theme="acidburn",
                  listening_frame=0, location=None, can_pause=False, paused=False):
        image = Image.new("RGB", (WIDTH, HEIGHT), BG)
        draw = ImageDraw.Draw(image)
        draw.rounded_rectangle((10, 11, 109, 129), radius=12, fill=PANEL)
        phase = status.phase
        resting = phase in ("Idling", "Paused")
        face = TEAL
        caption_y = 110
        if theme in LISTENING_FRAMES:
            try:
                moods = ZERO_COOL_MOODS if theme == "zero-cool" else ACIDBURN_MOODS
                mood = (LISTENING_FRAMES[theme][listening_frame] if phase == "Listening"
                        else moods.get(phase, "neutral"))
                icon, mask = theme_face(theme, mood)
                image.paste(icon, (15, 16), mask)
                caption_y = 116
            except OSError:
                self.draw_computer(draw, phase, blink)
        else:
            self.draw_computer(draw, phase, blink)
        draw.text((59, caption_y), "Z z" if resting else "ON AIR", font=self.small,
                  anchor="mm", fill=face)
        draw.text((123, 9), phase, font=self.title, fill=TEAL)
        if isinstance(status, wigle.WardriveStatus):
            self.draw_wardrive_stats(draw, status, location)
        elif isinstance(status, wifi.AttackStatus):
            self.draw_attack_stats(draw, status)
        else:
            phase_detail = {"Idling": "Sweep complete", "Uploading": "Sending saved hashes"}
            name = status.network or phase_detail.get(status.phase, "Looking for networks")
            while draw.textlength(name, font=self.body) > 180:
                name = name[:-2] + "…"
            draw.text((124, 33), name, font=self.body, fill=WHITE)
            draw.rounded_rectangle((124, 55, 306, 62), radius=3, fill=PANEL)
            if status.total:
                width = int(182 * status.attempted / status.total)
                draw.rounded_rectangle((124, 55, 124 + width, 62), radius=3, fill=face)
            progress = f"{status.attempted}/{status.total}"
            label = f"{progress} networks visited" if resting else f"Target {progress}"
            draw.text((124, 71), label, font=self.body, fill=WHITE)
            draw.text((124, 91), f"{status.found} handshakes", font=self.body, fill=WHITE)
            draw.text((124, 109), f"{status.deauths} deauth bursts", font=self.small, fill=MUTED)
            if status.skipped or status.failed or status.upload_failed:
                errors = status.failed + status.upload_failed
                draw.text((124, 125), f"{status.skipped} skipped  •  {errors} failed",
                          font=self.small, fill=MUTED)
            elif status.uploaded or status.queued:
                draw.text((124, 125), f"{status.uploaded} uploaded  •  {status.queued} queued",
                          font=self.small, fill=MUTED)
        draw.line((12, 142, 308, 142), fill=PANEL)
        footer = "Esc Back" if resting else "Esc to stop"
        if can_pause:
            footer = ("P Resume" if paused else "P Pause") + "   /   Esc to stop"
        draw.text((12, 150), footer, font=self.small, fill=MUTED)
        gps_color = TEAL if gps_on else MUTED
        net_color = TEAL if online else MUTED
        # All three symbols occupy the same 14-pixel band.
        if not isinstance(status, wifi.AttackStatus):
            draw.polygon(((226, 152), (229, 149), (232, 152), (229, 155)), fill=gps_color)
            draw.polygon(((234, 159), (237, 156), (240, 159), (237, 162)), fill=gps_color)
            draw.polygon(((229, 157), (234, 152), (237, 155), (232, 160)), outline=gps_color)
            draw.arc((236, 149, 243, 156), 270, 360, fill=gps_color)
            if not gps_on:
                draw.line((226, 149, 242, 162), fill="#e5a183")
        draw.ellipse((254, 149, 267, 162), outline=net_color)
        draw.ellipse((259, 149, 262, 162), outline=net_color)
        draw.line((255, 155, 266, 155), fill=net_color)
        if not online:
            draw.line((254, 149, 267, 162), fill="#e5a183")
        color = MUTED if battery is None else "#ff9c73" if battery < 20 else TEAL
        draw.rectangle((281, 149, 303, 162), outline=color)
        draw.rectangle((304, 154, 306, 158), fill=color)
        if battery:
            draw.rectangle((283, 152, 282 + max(1, int(battery * .19)), 160), fill=color)
        self.paint(image)

    def draw_wardrive_stats(self, draw, status, location):
        draw.text((124, 32), "Wardriving", font=self.small, fill=MUTED)
        draw.text((124, 49), f"{status.networks} networks  •  {status.scans} scans",
                  font=self.body, fill=WHITE)
        draw.text((124, 66), f"{status.observations} GPS observations", font=self.body, fill=WHITE)
        if status.phase == "Private":
            draw.text((124, 99), "Private zone: scan paused", font=self.body, fill=TEAL)
            return
        if location:
            latitude, longitude, accuracy, current = location
            draw.text((124, 87), "GPS fix" if current else "Last GPS fix", font=self.small, fill=TEAL)
            draw.text((124, 102), f"{latitude}, {longitude}", font=self.body, fill=WHITE)
            if not status.error:
                draw.text((124, 121), f"Accuracy ~{accuracy} m", font=self.small, fill=MUTED)
        else:
            draw.text((124, 99), "Waiting for GPS fix", font=self.body, fill=MUTED)
        if status.error:
            draw.text((124, 121), "Scan unavailable; retrying", font=self.small, fill=MUTED)

    def draw_attack_stats(self, draw, status):
        network = status.network
        name = "".join(char if char.isprintable() else " " for char in network.ssid) or "Hidden SSID"
        while draw.textlength(name, font=self.body) > 180:
            name = name[:-2] + "…"
        draw.text((124, 31), status.operation, font=self.small, fill=MUTED)
        draw.text((124, 46), name, font=self.body, fill=WHITE)
        draw.text((124, 63), f"{network.bssid}  •  {network.frequency} MHz",
                  font=self.small, fill=MUTED)
        has_capture = status.operation != "Deauth Attack"
        metrics = f"{status.elapsed}s elapsed"
        if has_capture:
            metrics += f"  •  {status.size / 1024:.1f} KiB captured"
        draw.text((124, 80), metrics, font=self.small, fill=WHITE)
        if status.operation != "Passive Capture":
            draw.text((124, 96), f"{status.clients} clients  •  {status.bursts} bursts",
                      font=self.small, fill=WHITE)
            draw.text((124, 111), f"{status.attempts} attempts  •  {status.failures} failed",
                      font=self.small, fill=MUTED)
        if has_capture:
            label = f"{status.result} found" if status.result else "Waiting for handshake or PMKID"
            draw.text((124, 126), label, font=self.small, fill=TEAL if status.result else MUTED)

    def paint(self, image):
        self.frame = struct.pack(f"<{WIDTH * HEIGHT}H", *(
            (red >> 3) << 11 | (green >> 2) << 5 | blue >> 3
            for red, green, blue in image.getdata()
        ))
        self.present()

    def present(self):
        if self.stride == WIDTH * 2:
            if os.pwrite(self.fd, self.frame, self.offset) != len(self.frame):
                raise OSError("Short LCD write")
            return
        for row in range(HEIGHT):
            start = row * WIDTH * 2
            data = self.frame[start:start + WIDTH * 2]
            if os.pwrite(self.fd, data, self.offset + row * self.stride) != len(data):
                raise OSError("Short LCD write")


class App:
    def __init__(self, display, keyboard, executor):
        self.display = display
        self.keyboard = keyboard
        self.executor = executor
        self.cancel = threading.Event()
        self.pause = threading.Event()
        self.future = None
        theme = wifi.read_setting("theme")
        self.theme = theme if theme in THEMES else "acidburn"
        self.editor = None
        self.gnss = None
        self.gps_on = False
        self.wardrive_location = None
        self.online = False
        self.battery = None
        self.connectivity = None
        self.next_status = 0
        self.survey_job = None
        self.survey_cancel = threading.Event()
        self.next_survey = 0
        self.survey_executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.running = True
        self.shift = set()
        self.home()

    def screen(self, title, message="", items=(), back=None, footer=None):
        self.auto_status = None
        self.title, self.message, self.items = title, message, items
        self.index, self.back, self.footer = 0, back, footer
        self.dirty = True

    def home(self):
        self.screen("Zerogotchi", items=(
            (AUTO_ATTACK_TITLE, self.auto), ("Wardriving", self.wardriving), (MANUAL_ATTACK_TITLE, self.disclaimer),
            ("About", self.about),
            ("Settings", self.settings), ("Update", self.update), ("Exit", self.exit),
        ), back=self.exit)

    def auto(self):
        self.screen(AUTO_ATTACK_TITLE, "Auto sends deauth frames on nearby networks. Use it only where you "
                    "own every target. It visits each network once and then idles.",
                    (("Start sweep", self.start_auto), ("Session log", self.auto_log)), back=self.home)

    def wardriving(self):
        self.screen("Wardriving", "Scan for nearby networks and save GPS-tagged observations locally.",
                    (("Start", self.start_wardriving), ("Saved surveys", lambda: self.wigle_surveys(self.wardriving))),
                    back=self.home)

    def start_wardriving(self):
        adapter = wifi.read_setting("wardriving-adapter") or "wlan0"

        def authenticate(password):
            monitor = gnss.GnssMonitor(wifi.HELPER, password)
            self.gnss = monitor
            self.wardrive_location = None
            self.work("Wardriving", "",
                      lambda: wigle.wardrive(adapter, lambda: monitor.position(time.monotonic()),
                                             self.cancel, self.report_capture, pause=self.pause),
                      self.wardrive_done, self.wardriving, cancellable=True)
            self.auto_status = wigle.WardriveStatus("Scanning")

        self.edit("Cardputer user password", "Enter your Cardputer login password to power GPS.",
                  re.compile(r"[ -~]{1,256}"), 256, authenticate, self.wardriving, masked=True)

    def wardrive_done(self, status):
        summary = (f"{status.networks} networks in {status.scans} scans. "
                   f"{status.observations} GPS observations saved.")
        options = (("Exit to main menu", self.home),)
        if status.survey:
            options += self.survey_options(status.survey, lambda: self.wardrive_done(status), self.home)
        self.screen("Wardriving stopped", summary, options, back=self.home)

    def auto_log(self):
        try:
            with wifi.AUTO_LOG.open(encoding="utf-8") as source:
                lines = deque(source, maxlen=120)
        except OSError:
            lines = []
        entries = tuple((line.rstrip()[26:], lambda line=line: self.screen(
            "Session log", line.rstrip()[26:], back=self.auto_log
        )) for line in lines)
        self.screen("Session log", "" if entries else "No Auto WiFi Attack session log yet.", entries, self.auto)

    def start_auto(self):
        adapter = wifi.read_setting("adapter")
        if not adapter:
            self.screen("WiFi adapter required", "Select a USB WiFi adapter in Settings.", back=self.auto)
            return
        if adapter == "wlan0":
            self.screen("Built-in WiFi", "The stock driver supports scanning only. Select a USB adapter for Auto WiFi Attack.",
                        back=self.auto)
            return
        auto_upload = bool(wifi.KEY_PATTERN.fullmatch(wifi.read_setting("api-key")))
        if auto_upload:
            self.screen("Auto WiFi Attack uploads", "Auto will send any new WPA hashes to OnlineHashCrack. "
                        "Read and accept the terms before proceeding.\n"
                        "onlinehashcrack.com/terms-conditions.php",
                        (("Agree and continue", lambda: self.auto_password(adapter, True, self.start_auto)),
                         ("Cancel", self.auto)), self.auto)
        else:
            self.auto_password(adapter, False, self.auto)

    def auto_password(self, adapter, auto_upload, back):
        def authenticate(password):
            self.gnss = gnss.GnssMonitor(wifi.HELPER, password)
            self.survey_cancel = threading.Event()
            self.next_survey = 0 if wigle.credentials() else float("inf")
            self.work(AUTO_ATTACK_TITLE, "",
                      lambda: wifi.auto_capture(adapter, password, self.cancel, self.report_capture,
                                                auto_upload=auto_upload, pause=self.pause),
                      self.auto_done, self.auto, cancellable=True)
            self.auto_status = wifi.AutoStatus("Scanning")

        self.edit("Cardputer user password", "Enter your Cardputer login password for this sweep.",
                  re.compile(r"[ -~]{1,256}"), 256, authenticate, back, masked=True)

    def auto_done(self, status):
        if status.phase == "Stopped":
            self.home()
            return
        self.screen(AUTO_ATTACK_TITLE, back=self.home)
        self.auto_status = status

    def about(self):
        self.screen("About", "Zerogotchi by unagisan69\n\n"
                    "A Wi-Fi lab auditor for Cardputer Zero. Auto and Manual WiFi Attack capture WPA handshakes. "
                    "Wardriving logs GPS observations. Supports WiGLE, WDG Wars, OnlineHashCrack, and face themes.",
                    back=self.home)

    def update(self):
        self.work("Update", "Checking the latest GitHub release…", updater.check, self.update_available, self.home)

    def update_available(self, release):
        if not release.available:
            self.screen("Up to date", f"Installed version: {release.current}", back=self.home)
            return
        self.screen("Update available", f"Installed: {release.current}\nGitHub: {release.latest}",
                    (("Install update", lambda: self.update_password(release)), ("Cancel", self.home)),
                    back=self.home)

    def update_password(self, release):
        def install(password):
            self.work("Updating", "Downloading, verifying, and installing the release…",
                      lambda: updater.install(release, password),
                      lambda _: self.screen("Update installed",
                                            f"Version {release.latest} is ready. Reopen from the launcher.",
                                            (("Exit to launcher", self.exit),), back=self.exit),
                      self.update)
        self.edit("Cardputer user password", "Enter your Cardputer login password to install the update.",
                  re.compile(r"[ -~]{1,256}"), 256, install,
                  lambda: self.update_available(release), masked=True)

    def exit(self):
        self.running = False

    def disclaimer(self):
        self.screen("Authorized use only",
                    "Only test Wi-Fi networks you own. Deauthentication can disconnect a device.",
                    (("Okay", self.attack), ("Cancel", self.home)), self.home)

    def attack(self):
        self.screen(MANUAL_ATTACK_TITLE, items=(
            ("Scan nearby networks", self.start_scan), ("Saved captures", self.saved),
        ), back=self.home)

    def start_scan(self):
        self.work("Scanning", "Looking for nearby Wi-Fi networks…", wifi.scan,
                  self.networks, self.attack)

    def networks(self, networks):
        self.screen("Nearby networks", "" if networks else "No Wi-Fi networks found.", tuple(
            (f"{network.signal:>3}%  {self.network_name(network)}",
             lambda network=network: self.target(network, networks)) for network in networks
        ), self.attack)

    @staticmethod
    def network_name(network):
        return "".join(char if char.isprintable() else " " for char in network.ssid) or "(hidden SSID)"

    def target(self, network, networks):
        back = lambda: self.networks(networks)
        target = lambda: self.target(network, networks)
        self.screen("Selected network",
                    f"{self.network_name(network)}  •  {network.security or 'Open'}\n"
                    f"{network.bssid}  •  {network.frequency} MHz",
                    (("Active Capture", lambda: self.confirm_attack(network, "active", target)),
                     ("Passive Capture", lambda: self.start_capture(network, "passive", target)),
                     ("Deauth Attack", lambda: self.confirm_attack(network, "deauth", target))), back)

    def confirm_attack(self, network, mode, back):
        title = "Active Capture" if mode == "active" else "Deauth Attack"
        self.screen(title, f"Disconnect discovered clients on {self.network_name(network)}?\n{network.bssid}",
                    (("Start", lambda: self.start_capture(network, mode, back)),
                     ("Cancel", back)), back)

    def start_capture(self, network, mode, back):
        adapter = wifi.read_setting("adapter")
        if not adapter:
            self.screen("WiFi adapter required", "Select a USB WiFi adapter in Settings.", back=back)
            return
        if adapter == "wlan0":
            self.screen("Built-in WiFi", "The stock driver supports scanning only. Select a USB adapter for capture.",
                        back=back)
            return

        def authenticate(password):
            title = wifi.ATTACK_LABELS[mode]
            self.work(title, "Preparing USB adapter…",
                      lambda: wifi.capture(network, adapter, mode, password, self.cancel,
                                           lambda _: None, attack_report=self.report_capture),
                      lambda result: self.capture_done(result, back), back, cancellable=True)
            self.auto_status = wifi.AttackStatus("Tuning", title, network)

        self.edit("Cardputer user password",
                  "Enter your Cardputer login password to grant sudo radio access.",
                  re.compile(r"[ -~]{1,256}"), 256, authenticate, back, masked=True)

    def report_capture(self, message):
        self.capture_update = message

    def capture_done(self, result, back):
        pcap, hashes, kind = result
        if pcap is None:
            self.screen("Deauth stopped", "Returned the USB adapter to its original state.",
                        back=back)
            return
        if hashes and wifi.KEY_PATTERN.fullmatch(wifi.read_setting("api-key")):
            self.screen(f"{kind} captured", "PCAP and WPA hash saved. Upload to OnlineHashCrack?",
                        (("Upload", lambda: self.terms(hashes, self.saved)),
                         ("Keep local", self.saved)), self.saved)
            return
        message = "PCAP and WPA hash file saved." if hashes else "PCAP saved. No usable WPA handshake or PMKID."
        self.screen(f"{kind} captured" if kind else "Capture complete", message, back=back)

    def saved(self):
        captures = wifi.saved_captures()
        handshakes = [path for path, _ in wifi.saved_handshakes()]
