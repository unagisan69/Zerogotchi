                except ProcessLookupError:
                    pass
            process.communicate()

    def poll_startup_update(self, now):
        process = self.startup_process
        if process is not None:
            if process.poll() is not None:
                output, _ = process.communicate()
                self.startup_process = None
                try:
                    release = updater.Release(**json.loads(output))
                    if release.available:
                        self.startup_release = release
                except (TypeError, ValueError):
                    pass
            elif now >= self.startup_deadline:
                self.stop_startup_check()
        if (self.startup_release is not None and self.title == "Zerogotchi"
                and not self.future and not self.editor and self.auto_status is None):
            release, self.startup_release = self.startup_release, None
            self.update_available(release)

