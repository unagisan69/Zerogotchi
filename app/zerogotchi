    def subghz_record_result(self, data, path=None, return_to=None):
        duration = sum(abs(value) for value in data['pulses']) / 1_000_000
        back = return_to or (self.subghz_saved if path else self.start_subghz)
        def erase():
            try:
                if path:
                    path.unlink()
                back()
            except OSError:
                self.screen("Erase failed", "Could not erase recording.", back=back)
        def save():
            try:
                saved = subghz.save_record(data)
                self.screen("Recording saved", saved.name, back=self.subghz_saved)
            except (OSError, wifi.WifiError) as error:
                self.screen("Save failed", str(error), back=lambda: self.subghz_record_result(data))
        def replay():
            def begin():
                self.work("Replay OOK", "Transmitting once… Esc to stop.",
                          lambda: subghz.replay(subghz.hat_key(), data, self.cancel, self.report_capture),
                          lambda result: self.screen("Replay", result,
                              back=lambda: self.subghz_record_result(data, path, return_to)),
                          lambda: self.subghz_record_result(data, path, return_to), cancellable=True)
            self.screen("Replay transmission?",
                        f"{data['frequency']:g} MHz · OOK · {duration:.2f}s\n"
                        "Transmit only where permitted and with authorized equipment.",
                        (("Cancel", lambda: self.subghz_record_result(data, path, return_to)), ("Replay once", begin)),
                        back=lambda: self.subghz_record_result(data, path, return_to))
        self.screen("Saved OOK" if path else "Recording stopped",
                    f"{data['frequency']:g} MHz · {duration:.2f}s · {len(data['pulses'])} pulses",
                    (("Erase", erase), ("Replay", replay)) + (() if path else (("Save", save),)), back=back)

