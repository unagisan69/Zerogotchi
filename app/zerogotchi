    def edit(self, title, prompt, pattern, limit, commit, back, *, initial="", masked=False, tail=False):
        self.editor = {
            "title": title, "prompt": prompt, "pattern": pattern, "limit": limit,
            "commit": commit, "back": back, "value": initial, "masked": masked, "tail": tail,
        }
        self.update_editor()

    def update_editor(self, feedback=""):
        editor = self.editor
        value = editor["value"]
        field = f"•  {len(value)} characters" if editor["masked"] else (value or "▌")
        if editor["tail"] and len(value) > 28:
            field = "…" + value[-28:]
        self.screen(editor["title"], editor["prompt"] + "\n\n" + field + "\n" + feedback,
                    footer="Enter Save   /   Esc Cancel")

    def edit_key(self, key):
        editor = self.editor
        value = editor["value"]
        if key == KEY_ESC:
            self.editor = None
            editor["back"]()
        elif key == KEY_ENTER:
            if not editor["pattern"].fullmatch(value):
                self.update_editor("Invalid format")
                return
            self.editor = None
            try:
                editor["commit"](value)
            except OSError:
                self.screen("Could not save setting", back=editor["back"])
        elif key == KEY_BACKSPACE:
            editor["value"] = value[:-1]
            self.update_editor()
        elif key in KEYS and len(value) < editor["limit"]:
            char = KEYS[key]
            editor["value"] += SHIFTED.get(char, char.upper()) if self.shift else char
            self.update_editor()

    def work(self, title, prompt, operation, success, back, *, cancellable=False):
        self.cancel.clear()
        self.pause.clear()
        self.capture_update = None
        self.future = self.executor.submit(operation)
        self.finished, self.failed = success, back
        self.cancellable = cancellable
        self.screen(title, prompt, footer="Esc Stop" if cancellable else "Please wait")

    def key(self, code, state):
        if code in (42, 54):
            self.shift.add(code) if state else self.shift.discard(code)
        if state != 1:
            return
        if self.future:
            if (code == KEY_P and not self.cancel.is_set()
                    and isinstance(self.auto_status, (wifi.AutoStatus, wigle.WardriveStatus))):
                if self.pause.is_set():
                    self.pause.clear()
                    self.auto_status = replace(self.auto_status, phase="Resuming")
                else:
                    self.pause.set()
                    self.auto_status = replace(self.auto_status, phase="Pausing")
                self.capture_update = None
                self.dirty = True
            elif self.cancellable and code == KEY_ESC:
                self.cancel.set()
                if isinstance(self.auto_status, wigle.WardriveStatus):
                    self.screen("Stopping Wardriving", "Finishing the current scan…", footer="Please wait")
                elif isinstance(self.auto_status, wifi.AutoStatus):
                    self.screen("Stopping Auto", "Finishing the current operation…", footer="Please wait")
                else:
                    self.screen("Finishing capture", "Saving received packets…", footer="Please wait")
        elif self.editor:
            self.edit_key(code)
        elif code == KEY_ESC and self.back:
            self.back()
        elif self.items and code in (KEY_UP, KEY_DOWN, 33, 45):
            self.index = (self.index + (-1 if code in (KEY_UP, 33) else 1)) % len(self.items)
            self.dirty = True
        elif self.items and code == KEY_ENTER:
            self.items[self.index][1]()

    def poll_device_status(self, now):
        if self.connectivity:
            process, started = self.connectivity
            if process.poll() is not None or now - started >= 4:
                if process.poll() is None:
                    process.kill()
                output, _ = process.communicate()
                self.connectivity = None
                online = process.returncode == 0 and output.strip() == "full"
                if online != self.online:
                    self.online, self.dirty = online, True
        if now < self.next_status:
            return
        self.next_status = now + 15
        if not self.connectivity:
            try:
                self.connectivity = (subprocess.Popen(
                    ["nmcli", "networking", "connectivity", "check"], stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL, text=True, env={**os.environ, "LC_ALL": "C"},
                ), now)
            except OSError:
                self.online = False
        battery = None
        for supply in Path("/sys/class/power_supply").glob("*"):
            try:
                if (supply / "type").read_text().strip() == "Battery":
                    battery = int((supply / "capacity").read_text().strip())
                    if 0 <= battery <= 100:
                        break
                    battery = None
            except (OSError, ValueError):
                continue
        if battery != self.battery:
            self.battery, self.dirty = battery, True

    def poll_survey(self, now):
        if self.survey_job:
            future, cancel = self.survey_job
            if not future.done():
                return
            self.survey_job = None
            if cancel is self.survey_cancel:
                try:
                    if future.result():
                        self.next_survey = float("inf")
                except (wifi.WifiError, OSError):
                    pass
        monitor = self.gnss
        if not self.pause.is_set() and monitor and monitor.position(now) and now >= self.next_survey:
            self.next_survey = now + 15
            future = self.survey_executor.submit(
                wigle.record_survey, lambda: monitor.position(time.monotonic()), self.survey_cancel, self.pause
            )
            self.survey_job = future, self.survey_cancel

    def run(self):
        # Repaint through the initial framebuffer handoff from APPLaunch.
        repaint_until = time.monotonic() + 2.0
        last_paint = 0.0
        last_blink = False
        listening_since = None
        last_listening_frame = 0
        try:
            while self.running:
                if self.future and self.future.done():
                    future, self.future = self.future, None
                    try:
                        self.finished(future.result())
                    except wifi.WifiError as error:
                        self.screen("Zerogotchi", str(error), back=self.failed)
                    except OSError:
                        self.screen("Zerogotchi", "Could not read or save app data.", back=self.failed)
                if self.future and self.cancellable and not self.cancel.is_set():
                    update = self.capture_update
                    if isinstance(update, (wifi.AutoStatus, wifi.AttackStatus, wigle.WardriveStatus)) and update != self.auto_status:
                        self.auto_status, self.dirty = update, True
                    elif isinstance(update, str) and update != self.message:
                        self.message, self.dirty = update, True
                now = time.monotonic()
                if self.gnss:
                    if not self.auto_status:
                        self.survey_cancel.set()
                        self.gnss.close()
                        self.gnss = None
                    gps_on = bool(self.gnss and self.gnss.poll(now))
                    if gps_on != self.gps_on:
                        self.gps_on, self.dirty = gps_on, True
                blink = self.theme == "computer" and int(now * 5) % 18 == 0
                listening_frame = 0
                if self.theme in LISTENING_FRAMES and self.auto_status and self.auto_status.phase == "Listening":
                    if listening_since is None:
                        listening_since = now
                    listening_frame = int((now - listening_since) * 3) % len(LISTENING_FRAMES[self.theme])
                else:
                    listening_since = None
                if self.auto_status:
                    self.poll_device_status(now)
                    if isinstance(self.auto_status, wigle.WardriveStatus):
                        fix = self.gnss.position(now) if self.gnss else None
                        location = self.wardrive_location
                        if fix:
                            location = (f"{fix.latitude:.6f}", f"{fix.longitude:.6f}", round(fix.accuracy), True)
                        elif location:
                            location = (*location[:3], False)
                        if location != self.wardrive_location:
                            self.wardrive_location, self.dirty = location, True
                    elif isinstance(self.auto_status, wifi.AutoStatus):
                        self.poll_survey(now)
                if self.auto_status and (self.dirty or blink != last_blink or listening_frame != last_listening_frame):
                    self.display.draw_auto(self.auto_status, blink, self.gps_on, self.online,
                                           self.battery, self.theme, listening_frame, self.wardrive_location,
                                           can_pause=bool(self.future) and isinstance(
                                               self.auto_status, (wifi.AutoStatus, wigle.WardriveStatus)),
                                           paused=self.pause.is_set())
                    last_listening_frame = listening_frame
                    self.dirty, last_paint, last_blink = False, now, blink
                elif self.dirty:
                    footer = self.footer
                    if footer is None:
                        footer = "F/X Move   /   Enter Select   /   Esc Back" if self.items else "Esc Back"
                    self.display.draw(self.title, self.message, self.items, self.index, footer)
                    self.dirty = False
                    last_paint = now
                elif now < repaint_until and now - last_paint >= 0.25:
                    self.display.present()
                    last_paint = now
                if select.select([self.keyboard], [], [], 0.15)[0]:
                    event = self.keyboard.read(INPUT_EVENT.size)
                    if len(event) != INPUT_EVENT.size:
                        raise OSError("Could not read built-in keyboard")
                    _, _, kind, code, state = INPUT_EVENT.unpack(event)
                    if kind == 1:
                        self.key(code, state)
        finally:
            self.cancel.set()
            self.survey_cancel.set()
            self.survey_executor.shutdown(wait=False, cancel_futures=True)
            if self.connectivity:
                process, _ = self.connectivity
                if process.poll() is None:
                    process.kill()
                process.communicate()
            if self.gnss:
                self.gnss.close()


