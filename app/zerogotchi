    def survey_options(self, path, back, done):
        providers = tuple((name, provider) for name, provider in (("WiGLE", wigle), ("WDG Wars", wdgwars))
                          if provider.credentials())
        options = tuple((f"Upload to {name}", lambda name=name, provider=provider:
                         self.confirm_survey(name, ((name, provider),), path, back, done))
                        for name, provider in providers)
        if len(providers) == 2:
            options = (("Upload to All", lambda: self.confirm_survey(
                "all services", providers, path, back, done)),) + options
        return options

    def confirm_survey(self, destination, providers, path, back, done):
        def upload():
            messages = []
            for name, provider in providers:
                try:
                    result = upload_queue.submit("wigle" if provider is wigle else "wdg", path)
                except (wifi.WifiError, OSError) as error:
                    result = str(error)
                messages.append(f"{name}: {result}" if len(providers) > 1 else result)
            return "\n".join(messages)

        self.screen(f"Upload to {destination}?",
                    "Send Wi-Fi/BLE names, addresses, signal levels and GPS locations now or when online?",
                    (("Upload", lambda: self.provider_request("Survey upload", upload, done)), ("Cancel", back)),
                    back)

