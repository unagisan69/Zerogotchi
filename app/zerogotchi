#!/usr/bin/python3
"""Zerogotchi's native Cardputer Zero launcher UI."""

import concurrent.futures
import csv
import fcntl
import os
import re
import select
import struct
import threading
import time

from PIL import Image, ImageDraw, ImageFont

import wifi


WIDTH, HEIGHT = 320, 170
BG, PANEL, TEAL, WHITE, MUTED = "#101c25", "#234145", "#6fffc1", "#f4f9fa", "#aebfc5"
FONT_DIR = "/usr/share/fonts/truetype/dejavu"
INPUT_EVENT = struct.Struct("@llHHi")
KEY_ESC, KEY_ENTER, KEY_UP, KEY_DOWN, KEY_BACKSPACE = 1, 28, 103, 108, 14
KEYS = {
    **dict(enumerate("1234567890-=", 2)),
    **dict(enumerate("qwertyuiop[]", 16)),
    **dict(enumerate("asdfghjkl;'`", 30)),
    **dict(enumerate("zxcvbnm,./", 44)),
    57: " ",
}
SHIFTED = dict(zip("1234567890-=;',./[]`", "!@#$%^&*()_+:\"<>?{}~"))
USB_NAME = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}")


class Display:
    def __init__(self, device):
        self.fd = device.fileno()
        mode = bytearray(160)
        fixed = bytearray(80)
        fcntl.ioctl(self.fd, 0x4600, mode)
        fcntl.ioctl(self.fd, 0x4602, fixed)
        width, height, _, _, xoffset, yoffset, bpp = struct.unpack_from("=7I", mode)
        red, green, blue = (struct.unpack_from("=2I", mode, offset) for offset in (32, 44, 56))
        stride = struct.unpack_from("=I", fixed, 48)[0]
        if (width, height, bpp, red, green, blue) != (320, 170, 16, (11, 5), (5, 6), (0, 5)):
            raise OSError("Expected Cardputer Zero RGB565 LCD")
        if stride < (xoffset + WIDTH) * 2:
            raise OSError("Invalid LCD line length")
        self.stride = stride
        self.offset = yoffset * stride + xoffset * 2
        self.title = ImageFont.truetype(f"{FONT_DIR}/DejaVuSans-Bold.ttf", 18)
        self.body = ImageFont.truetype(f"{FONT_DIR}/DejaVuSans.ttf", 13)
        self.small = ImageFont.truetype(f"{FONT_DIR}/DejaVuSans.ttf", 11)

    def wrap(self, text, draw):
        for paragraph in text.splitlines():
            if not paragraph:
                yield ""
                continue
            line = ""
            for word in paragraph.split():
                candidate = (line + " " + word).strip()
                if line and draw.textlength(candidate, font=self.body) > 292:
                    yield line
                    line = word
                else:
                    line = candidate
            if line:
                yield line

    def draw(self, title, message, items, index, footer):
        image = Image.new("RGB", (WIDTH, HEIGHT), BG)
        draw = ImageDraw.Draw(image)
        draw.text((12, 8), title, font=self.title, fill=TEAL)
        draw.line((12, 33, 308, 33), fill=PANEL)
        y = 40
        for line in self.wrap(message, draw):
            draw.text((13, y), line, font=self.body, fill=WHITE)
            y += 16
        window = max(1, (147 - y) // 21)
        first = min(max(0, index - window + 1), max(0, len(items) - window))
        for i in range(first, min(len(items), first + window)):
            label = items[i][0]
            if i == index:
                draw.rounded_rectangle((9, y, 310, y + 19), radius=4, fill=PANEL)
            if draw.textlength(label, font=self.body) > 281:
                while draw.textlength(label + "…", font=self.body) > 281:
                    label = label[:-1]
                label += "…"
            draw.text((15, y + 1), label, font=self.body, fill=TEAL if i == index else WHITE)
            y += 21
        draw.text((12, 151), footer, font=self.small, fill=MUTED)
        self.paint(image)

    def draw_auto(self, status, blink):
        image = Image.new("RGB", (WIDTH, HEIGHT), BG)
        draw = ImageDraw.Draw(image)
        draw.rounded_rectangle((10, 11, 109, 129), radius=12, fill=PANEL)
        resting = status.phase == "Idling"
        phase = status.phase
        face = TEAL
        mood = {"Idling": "sleep", "Deauthing": "focus", "Checking": "squint",
                "Saving": "happy", "Uploading": "focus"}.get(phase, "alert")
        tilt = -3 if blink and not resting else 0
        draw.line((59, 44, 67, 33 + tilt, 75, 33 + tilt), fill=face, width=3)
        draw.ellipse((73, 29 + tilt, 81, 37 + tilt), fill=face)
        draw.rounded_rectangle((25, 44, 94, 92), radius=9, outline=face, width=3)
        for x in (40, 72):
            if mood == "squint" and not blink:
                draw.line((x, 61, x + 6, 64, x, 67), fill=face, width=2)
            elif mood == "sleep" or blink:
                draw.line((x, 64, x + 7, 64), fill=face, width=2)
            elif mood == "focus":
                draw.line((x, 59, x + 7, 64), fill=face, width=3)
            elif mood == "happy":
                draw.arc((x, 57, x + 8, 69), 190, 350, fill=face, width=2)
            else:
                draw.rectangle((x, 60, x + 6, 68), fill=face)
        if mood in ("focus", "squint"):
            draw.line((54, 77, 65, 77), fill=face, width=2)
        else:
            draw.line((50, 75, 55, 79, 63, 79, 68, 75), fill=face, width=2)
        draw.text((59, 110), "Z z" if resting else "ON AIR", font=self.small,
                  anchor="mm", fill=face)
        draw.text((123, 9), status.phase, font=self.title, fill=TEAL)
        phase_detail = {"Idling": "Sweep complete", "Uploading": "Sending saved hashes"}
        name = status.network or phase_detail.get(status.phase, "Looking for networks")
        while draw.textlength(name, font=self.body) > 180:
            name = name[:-2] + "…"
        draw.text((124, 33), name, font=self.body, fill=WHITE)
        draw.rounded_rectangle((124, 55, 306, 62), radius=3, fill=PANEL)
        if status.total:
            width = int(182 * status.attempted / status.total)
            draw.rounded_rectangle((124, 55, 124 + width, 62), radius=3, fill=face)
        progress = f"{status.attempted}/{status.total}"
        label = f"{progress} networks visited" if resting else f"Target {progress}"
        draw.text((124, 71), label, font=self.body, fill=WHITE)
        draw.text((124, 91), f"{status.found} handshakes", font=self.body, fill=WHITE)
        if status.network:
            draw.text((124, 111), f"{status.deauths} deauth bursts sent",
                      font=self.small, fill=MUTED)
        elif status.uploaded or status.queued or status.upload_failed:
            draw.text((124, 111), f"{status.uploaded} sent  •  {status.queued} queued",
                      font=self.small, fill=MUTED)
        if status.skipped or status.failed or status.upload_failed:
            errors = status.failed + status.upload_failed
            y = 126 if status.network or status.uploaded or status.queued or status.upload_failed else 111
            draw.text((124, y), f"{status.skipped} skipped  •  {errors} failed",
                      font=self.small, fill=MUTED)
        draw.line((12, 142, 308, 142), fill=PANEL)
        draw.text((12, 150), "Esc Back" if resting else "Esc Stop sweep", font=self.small, fill=MUTED)
        self.paint(image)

    def paint(self, image):
        self.frame = struct.pack(f"<{WIDTH * HEIGHT}H", *(
            (red >> 3) << 11 | (green >> 2) << 5 | blue >> 3
            for red, green, blue in image.getdata()
        ))
        self.present()

    def present(self):
        if self.stride == WIDTH * 2:
            if os.pwrite(self.fd, self.frame, self.offset) != len(self.frame):
                raise OSError("Short LCD write")
            return
        for row in range(HEIGHT):
            start = row * WIDTH * 2
            data = self.frame[start:start + WIDTH * 2]
            if os.pwrite(self.fd, data, self.offset + row * self.stride) != len(data):
                raise OSError("Short LCD write")


class App:
    def __init__(self, display, keyboard, executor):
        self.display = display
        self.keyboard = keyboard
        self.executor = executor
        self.cancel = threading.Event()
        self.future = None
        self.editor = None
        self.running = True
        self.shift = set()
        self.home()

    def screen(self, title, message="", items=(), back=None, footer=None):
        self.auto_status = None
        self.title, self.message, self.items = title, message, items
        self.index, self.back, self.footer = 0, back, footer
        self.dirty = True

    def home(self):
        self.screen("Zerogotchi", items=(
            ("Auto", self.auto), ("Attack", self.disclaimer), ("About", self.about),
            ("Settings", self.settings), ("Exit", self.exit),
        ), back=self.exit)

    def auto(self):
        self.screen("Auto", "Auto sends deauth frames on nearby networks. Use it only where you "
                    "own every target. It visits each network once and then idles.",
                    (("Start sweep", self.start_auto), ("Cancel", self.home)), back=self.home)

    def start_auto(self):
        adapter = wifi.read_setting("adapter")
        if not adapter:
            self.screen("WiFi adapter required", "Select a USB WiFi adapter in Settings.", back=self.auto)
            return
        if adapter == "wlan0":
            self.screen("Built-in WiFi", "The stock driver supports scanning only. Select a USB adapter for Auto.",
                        back=self.auto)
            return
        auto_upload = bool(wifi.KEY_PATTERN.fullmatch(wifi.read_setting("api-key")))
        if auto_upload:
            self.screen("Auto uploads", "Auto will send any new WPA hashes to OnlineHashCrack. "
                        "Read and accept the terms before proceeding.\n"
                        "onlinehashcrack.com/terms-conditions.php",
                        (("Agree and continue", lambda: self.auto_password(adapter, True, self.start_auto)),
                         ("Cancel", self.auto)), self.auto)
        else:
            self.auto_password(adapter, False, self.auto)

    def auto_password(self, adapter, auto_upload, back):
        def authenticate(password):
            self.work("Auto", "",
                      lambda: wifi.auto_capture(adapter, password, self.cancel, self.report_capture,
                                                auto_upload=auto_upload),
                      self.auto_done, self.auto, cancellable=True)
            self.auto_status = wifi.AutoStatus("Scanning")

        self.edit("Cardputer user password", "Enter your Cardputer login password for this sweep.",
                  re.compile(r"[ -~]{1,256}"), 256, authenticate, back, masked=True)

    def auto_done(self, status):
        if status.phase == "Stopped":
            self.home()
            return
        self.screen("Auto", back=self.home)
        self.auto_status = status

    def about(self):
        self.screen("About", "Zerogotchi is a Wi-Fi audit tool for Cardputer Zero. "
                    "It finds nearby networks, captures WPA exchanges on authorized networks, "
                    "and can submit saved hashes to OnlineHashCrack.", back=self.home)

    def exit(self):
        self.running = False

    def disclaimer(self):
        self.screen("Authorized use only",
                    "Only test Wi-Fi networks you own. Deauthentication can disconnect a device.",
                    (("Okay", self.attack), ("Cancel", self.home)), self.home)

    def attack(self):
        self.screen("Attack", items=(
            ("Scan nearby networks", self.start_scan), ("Saved captures", self.saved),
        ), back=self.home)

    def start_scan(self):
        self.work("Scanning", "Looking for nearby Wi-Fi networks…", wifi.scan,
                  self.networks, self.attack)

    def networks(self, networks):
        self.screen("Nearby networks", "" if networks else "No Wi-Fi networks found.", tuple(
            (f"{network.signal:>3}%  {self.network_name(network)}",
             lambda network=network: self.target(network, networks)) for network in networks
        ), self.attack)

    @staticmethod
    def network_name(network):
        return "".join(char if char.isprintable() else " " for char in network.ssid) or "(hidden SSID)"

    def target(self, network, networks):
        back = lambda: self.networks(networks)
        target = lambda: self.target(network, networks)
        self.screen("Selected network",
                    f"{self.network_name(network)}  •  {network.security or 'Open'}\n"
                    f"{network.bssid}  •  {network.frequency} MHz",
                    (("Passive Capture", lambda: self.start_capture(network, "passive", target)),
                     ("Deauth Attack", lambda: self.confirm_attack(network, "deauth", target)),
                     ("Active Capture", lambda: self.confirm_attack(network, "active", target))), back)

    def confirm_attack(self, network, mode, back):
        title = "Active Capture" if mode == "active" else "Deauth Attack"
        self.screen(title, f"Disconnect discovered clients on {self.network_name(network)}?\n{network.bssid}",
                    (("Start", lambda: self.start_capture(network, mode, back)),
                     ("Cancel", back)), back)

    def start_capture(self, network, mode, back):
        adapter = wifi.read_setting("adapter")
        if not adapter:
            self.screen("WiFi adapter required", "Select a USB WiFi adapter in Settings.", back=back)
            return
        if adapter == "wlan0":
            self.screen("Built-in WiFi", "The stock driver supports scanning only. Select a USB adapter for capture.",
                        back=back)
            return

        def authenticate(password):
            title = {"passive": "Passive Capture", "active": "Active Capture", "deauth": "Deauth Attack"}[mode]
            self.work(title, "Preparing USB adapter…",
                      lambda: wifi.capture(network, adapter, mode, password, self.cancel, self.report_capture),
                      lambda result: self.capture_done(result, back), back, cancellable=True)

        self.edit("Cardputer user password",
                  "Enter your Cardputer login password to grant sudo radio access.",
                  re.compile(r"[ -~]{1,256}"), 256, authenticate, back, masked=True)

    def report_capture(self, message):
        self.capture_update = message

    def capture_done(self, result, back):
        pcap, hashes, kind = result
        if pcap is None:
            self.screen("Deauth stopped", "Returned the USB adapter to its original state.",
                        back=back)
            return
        if hashes and wifi.KEY_PATTERN.fullmatch(wifi.read_setting("api-key")):
            self.screen(f"{kind} captured", "PCAP and WPA hash saved. Upload to OnlineHashCrack?",
                        (("Upload", lambda: self.terms(hashes, self.saved)),
                         ("Keep local", self.saved)), self.saved)
            return
        message = "PCAP and WPA hash file saved." if hashes else "PCAP saved. No usable WPA handshake or PMKID."
        self.screen(f"{kind} captured" if kind else "Capture complete", message, back=back)

    def saved(self):
        captures = wifi.saved_captures()
        self.screen("Saved captures", "" if captures else "No captures saved.", tuple(
            (f"{wifi.capture_name(path)}  •  {time.strftime('%b %d %H:%M', time.localtime(path.stat().st_mtime))}",
             lambda path=path: self.details(path)) for path in captures
        ), self.attack)

    def details(self, path):
        hashes = wifi.capture_hashfile(path)
        can_upload = hashes.exists() and wifi.KEY_PATTERN.fullmatch(wifi.read_setting("api-key"))
        self.screen("Saved capture", wifi.capture_name(path) + "\n" + path.parent.name + "\n" +
                    ("PCAP and WPA hash file" if hashes.exists() else "PCAP only"),
                    (("Submit WPA hashes", lambda: self.terms(hashes, self.saved)),)
                    if can_upload else (), self.saved)

    def terms(self, path, back):
        self.screen("Submit to OnlineHashCrack",
                    "To proceed, confirm you have read and accepted the service terms and "
                    "authorize sending these WPA hashes.\nwww.onlinehashcrack.com/terms-conditions.php",
                    (("Accept and submit", lambda: self.send(path, back)),), back)

    def send(self, path, back):
        def done(counts):
            accepted, skipped, rejected = counts
            self.screen("Submission result",
                        f"Accepted {accepted}. Skipped {skipped}. Rejected {rejected}.", back=back)
        self.work("Submitting", "Sending WPA hashes to OnlineHashCrack…", lambda: wifi.upload(path),
                  done, back)

    def settings(self):
        is_set = bool(wifi.KEY_PATTERN.fullmatch(wifi.read_setting("api-key")))
        adapter = wifi.read_setting("adapter")
        try:
            exclusions = len(wifi.blacklist())
        except wifi.WifiError:
            exclusions = "invalid"
        self.screen("Settings", items=(
            (f"WiFi Adapter: {'Built-in' if adapter == 'wlan0' else adapter or 'unset'}", self.adapter),
            (f"OnlineHashCrack API key: {'set' if is_set else 'unset'}", self.api_key),
            (f"SSID blacklist: {exclusions}", self.edit_blacklist),
        ), back=self.home)

    def edit_blacklist(self):
        def open_editor(value):
            self.edit("SSID blacklist", "Separate names with commas. Quote names containing commas.",
                      re.compile(r"[^\r\n]*"), 1024, save, self.settings, initial=value, tail=True)

        def save(value):
            try:
                wifi.parse_blacklist(value)
            except csv.Error:
                open_editor(value)
                self.update_editor("Check commas and quotes.")
                return
            wifi.save_setting("ssid-blacklist", value)
            self.settings()

        open_editor(wifi.read_setting("ssid-blacklist"))

    def adapter(self):
        self.screen("WiFi Adapter", items=(
            ("Built-in (wlan0) · scan only", lambda: self.save_adapter("wlan0")),
            ("wlan1", lambda: self.save_adapter("wlan1")),
            ("Custom…", self.custom_adapter),
        ), back=self.settings)

    def save_adapter(self, value):
        try:
            wifi.save_setting("adapter", value)
        except OSError:
            self.screen("Could not save adapter", back=self.adapter)
            return
        self.settings()

    def custom_adapter(self):
        self.edit("Custom WiFi adapter", "Enter the interface name of a dedicated USB WiFi adapter.",
                  USB_NAME, 15, self.save_adapter, self.adapter, initial=wifi.read_setting("adapter"))

    def api_key(self):
        def save(value):
            wifi.save_setting("api-key", value)
            self.settings()
        self.edit("OnlineHashCrack key", "Enter your API key. Characters are hidden.",
                  wifi.KEY_PATTERN, 67, save, self.settings, masked=True)

    def edit(self, title, prompt, pattern, limit, commit, back, *, initial="", masked=False, tail=False):
        self.editor = {
            "title": title, "prompt": prompt, "pattern": pattern, "limit": limit,
            "commit": commit, "back": back, "value": initial, "masked": masked, "tail": tail,
        }
        self.update_editor()

    def update_editor(self, feedback=""):
        editor = self.editor
        value = editor["value"]
        field = f"•  {len(value)} characters" if editor["masked"] else (value or "▌")
        if editor["tail"] and len(value) > 28:
            field = "…" + value[-28:]
        self.screen(editor["title"], editor["prompt"] + "\n\n" + field + "\n" + feedback,
                    footer="Enter Save   /   Esc Cancel")

    def edit_key(self, key):
        editor = self.editor
        value = editor["value"]
        if key == KEY_ESC:
            self.editor = None
            editor["back"]()
        elif key == KEY_ENTER:
            if not editor["pattern"].fullmatch(value):
                self.update_editor("Invalid format")
                return
            self.editor = None
            try:
                editor["commit"](value)
            except OSError:
                self.screen("Could not save setting", back=editor["back"])
        elif key == KEY_BACKSPACE:
            editor["value"] = value[:-1]
            self.update_editor()
        elif key in KEYS and len(value) < editor["limit"]:
            char = KEYS[key]
            editor["value"] += SHIFTED.get(char, char.upper()) if self.shift else char
            self.update_editor()

    def work(self, title, prompt, operation, success, back, *, cancellable=False):
        self.cancel.clear()
        self.capture_update = None
        self.future = self.executor.submit(operation)
        self.finished, self.failed = success, back
        self.cancellable = cancellable
        self.screen(title, prompt, footer="Esc Stop" if cancellable else "Please wait")

    def key(self, code, state):
        if code in (42, 54):
            self.shift.add(code) if state else self.shift.discard(code)
        if state != 1:
            return
        if self.future:
            if self.cancellable and code == KEY_ESC:
                self.cancel.set()
                if self.auto_status:
                    self.screen("Stopping Auto", "Finishing the current operation…", footer="Please wait")
                else:
                    self.screen("Finishing capture", "Saving received packets…", footer="Please wait")
        elif self.editor:
            self.edit_key(code)
        elif code == KEY_ESC and self.back:
            self.back()
        elif self.items and code in (KEY_UP, KEY_DOWN, 33, 45):
            self.index = (self.index + (-1 if code in (KEY_UP, 33) else 1)) % len(self.items)
            self.dirty = True
        elif self.items and code == KEY_ENTER:
            self.items[self.index][1]()

    def run(self):
        # Repaint through the initial framebuffer handoff from APPLaunch.
        repaint_until = time.monotonic() + 2.0
        last_paint = 0.0
        last_blink = False
        try:
            while self.running:
                if self.future and self.future.done():
                    future, self.future = self.future, None
                    try:
                        self.finished(future.result())
                    except wifi.WifiError as error:
                        self.screen("Zerogotchi", str(error), back=self.failed)
                    except OSError:
                        self.screen("Zerogotchi", "Could not read or save app data.", back=self.failed)
                if self.future and self.cancellable and not self.cancel.is_set():
                    update = self.capture_update
                    if isinstance(update, wifi.AutoStatus) and update != self.auto_status:
                        self.auto_status, self.dirty = update, True
                    elif isinstance(update, str) and update != self.message:
                        self.message, self.dirty = update, True
                now = time.monotonic()
                blink = int(now * 5) % 18 == 0
                if self.auto_status and (self.dirty or blink != last_blink):
                    self.display.draw_auto(self.auto_status, blink)
                    self.dirty, last_paint, last_blink = False, now, blink
                elif self.dirty:
                    footer = self.footer
                    if footer is None:
                        footer = "F/X Move   /   Enter Select   /   Esc Back" if self.items else "Esc Back"
                    self.display.draw(self.title, self.message, self.items, self.index, footer)
                    self.dirty = False
                    last_paint = now
                elif now < repaint_until and now - last_paint >= 0.25:
                    self.display.present()
                    last_paint = now
                if select.select([self.keyboard], [], [], 0.15)[0]:
                    event = self.keyboard.read(INPUT_EVENT.size)
                    if len(event) != INPUT_EVENT.size:
                        raise OSError("Could not read built-in keyboard")
                    _, _, kind, code, state = INPUT_EVENT.unpack(event)
                    if kind == 1:
                        self.key(code, state)
        finally:
            self.cancel.set()


if __name__ == "__main__":
    with (
        open("/dev/fb_lcd", "r+b", buffering=0) as lcd,
        open("/dev/input/cardputer-zero-internal", "rb", buffering=0) as keyboard,
        concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor,
    ):
        App(Display(lcd), keyboard, executor).run()
