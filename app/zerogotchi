    def subghz_library_browse(self, folder=None, page=0):
        try:
            root = subghz_library.root()
            folder = root if folder is None else Path(folder)
            paths = subghz_library.entries(folder)
        except (OSError, wifi.WifiError) as error:
            self.screen("Library", str(error), back=self.subghz_library)
            return
        page = min(max(0,page), max(0,(len(paths)-1)//80))
        here = lambda: self.subghz_library_browse(folder, page)
        def open_file(path):
            if path.is_dir():
                self.subghz_library_browse(path)
                return
            try:
                self.subghz_record_result(subghz.load_record(path), path, here)
            except (OSError, wifi.WifiError) as error:
                self.screen("Library file", f"{path.name}\n{error}", back=here)
        items = tuple((("[+] " if path.is_dir() else "") + path.name,
                       lambda path=path: open_file(path)) for path in paths[page*80:(page+1)*80])
        if page:
            items += (("Previous page", lambda: self.subghz_library_browse(folder,page-1)),)
        if (page+1)*80 < len(paths):
            items += (("Next page", lambda: self.subghz_library_browse(folder,page+1)),)
        self.screen("Library files", f"{len(paths)} entries · page {page+1}" if paths else "No Library files. Import or add via SSH.",
                    items, back=self.subghz_library if folder == root else lambda: self.subghz_library_browse(folder.parent))

