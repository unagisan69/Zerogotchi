    def zone_editor(self, zones, index):
        def open_editor(value):
            self.edit("Private zone", "Latitude, longitude, radius in meters.\nExample: 40.0,-74.0,150",
                      re.compile(r"[0-9eE.,+ -]{1,64}"), 64, save, self.private_zones, initial=value, tail=True)

        def save(value):
            try:
                zone = survey_privacy.parse_zone(value)
            except wifi.WifiError as error:
                open_editor(value)
                self.update_editor(str(error))
                return
            updated = list(zones)
            if index is None:
                updated.append(zone)
            else:
                updated[index] = zone
            self.update_zones(updated)

        current = zones[index] if index is not None else None
        open_editor(f"{current.latitude},{current.longitude},{current.radius}" if current else "")

