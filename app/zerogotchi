    def poll_upload_queue(self, now):
        if self.queue_process is not None:
            if self.queue_process.poll() is None:
                return
            self.queue_process.wait()
            self.queue_process = None
        if now < self.next_queue or not self.online:
            return
        self.next_queue = now + 15
        try:
            if not upload_queue.has_pending():
                return
            self.queue_process = subprocess.Popen(
                [sys.executable, str(Path(__file__).with_name("upload_queue.py")), "--drain"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            pass

